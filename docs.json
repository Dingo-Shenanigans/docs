{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ReSkate",
  "colors": {
    "primary": "#0090FE",
    "light": "#3DAAFF",
    "dark": "#0070C9"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "Mods",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "mods/overview",
              "mods/installing",
              "mods/mod-folder",
              "mods/rules"
            ]
          },
          {
            "group": "Making mods",
            "pages": [
              "mods/studio",
              "mods/maps",
              "mods/parks",
              "mods/objects",
              "mods/music",
              "mods/variants"
            ]
          },
          {
            "group": "Sharing",
            "pages": [
              "mods/thunderstore"
            ]
          }
        ]
      },
      {
        "tab": "Servers",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "servers/overview",
              "servers/linux",
              "servers/configuration"
            ]
          },
          {
            "group": "Running a server",
            "pages": [
              "servers/maps",
              "servers/roles",
              "servers/moderation",
              "servers/votes",
              "servers/commands"
            ]
          }
        ]
      },
      {
        "tab": "Plugins",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "plugins/overview",
              "plugins/quickstart",
              "plugins/manifest",
              "plugins/permissions",
              "plugins/limits",
              "plugins/events"
            ]
          },
          {
            "group": "Core API",
            "pages": [
              "plugins/api/base",
              "plugins/api/time",
              "plugins/api/console",
              "plugins/api/storage",
              "plugins/api/files",
              "plugins/api/package",
              "plugins/api/json",
              "plugins/api/libraries",
              "plugins/api/http",
              "plugins/api/mods"
            ]
          },
          {
            "group": "Interface",
            "pages": [
              "plugins/api/overlay",
              "plugins/api/menu",
              "plugins/api/audio",
              "plugins/api/input",
              "plugins/api/camera",
              "plugins/api/capture"
            ]
          },
          {
            "group": "The skater and the world",
            "pages": [
              "plugins/api/skater",
              "plugins/api/board",
              "plugins/api/outfit",
              "plugins/api/animation",
              "plugins/api/world"
            ]
          },
          {
            "group": "Multiplayer",
            "pages": [
              "plugins/api/session",
              "plugins/api/chat",
              "plugins/api/server",
              "plugins/api/throwdowns"
            ]
          },
          {
            "group": "Game",
            "pages": [
              "plugins/api/music",
              "plugins/api/progression"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "plugins/guides/game-modes",
              "plugins/guides/drawing",
              "plugins/guides/clips",
              "plugins/guides/flying-camera",
              "plugins/guides/sounds",
              "plugins/examples"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Releases",
          "href": "https://github.com/Dingo-Shenanigans/ReSkate/releases",
          "icon": "download"
        },
        {
          "anchor": "Thunderstore",
          "href": "https://thunderstore.io/c/reskate/",
          "icon": "box-open"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Dingo-Shenanigans/ReSkate"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://github.com/Dingo-Shenanigans/ReSkate/releases"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Dingo-Shenanigans/ReSkate"
    }
  }
}
